@page
@model MyRazorWeb.Pages.IndexModel
@{
  ViewBag.Title = "Home page";
  ViewData["IsHomePage"] = true;
}
<div class="text-center">
  <div class="homepage-image-container mb-4">
    <img src="~/images/library-books.png" asp-append-version="true" alt="書籍管理系統：翻開的書本與整齊堆疊的藏書" class="homepage-image img-fluid" />
  </div>
  <h1 class="display-4"> 歡迎 </h1>
  <div>
    @Model.Greeting
    @{
      DisplayDate(DateTime.Now);
    }
  </div>
</div>
@functions {
  void DisplayDate(DateTime dt)
  {
    <span class="date">@dt.ToString("D")</span>
  }
}
